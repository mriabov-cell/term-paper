from datetime import datetime, timedelta
import tkinter as tk
from tkinter import messagebox, ttk




class Book:

    def __init__(
        self,
        book_id: int,
        title: str,
        author: str,
        year: int,
        is_available: bool = True,
    ):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.year = year
        self.is_available = is_available

    def __str__(self):
        status = "Доступна" if self.is_available else "Видана"
        return f"ID {self.book_id}: '{self.title}' — {self.author} ({self.year}) [{status}]"


class Reader:

    def __init__(
        self, reader_id: int, name: str, phone: str, is_blocked: bool = False
    ):
        self.reader_id = reader_id
        self.name = name
        self.phone = phone
        self.is_blocked = is_blocked

    def __str__(self):
        status = " (ЗАБЛОКОВАНИЙ)" if self.is_blocked else ""
        return (
            f"Читач ID {self.reader_id}: {self.name} ({self.phone}){status}"
        )


class BorrowRecord:

    def __init__(
        self, record_id: int, book: Book, reader: Reader, days_allowed: int = 14
    ):
        self.record_id = record_id
        self.book = book
        self.reader = reader
        self.issue_date = datetime.now()
        self.due_date = self.issue_date + timedelta(days=days_allowed)
        self.is_returned = False

    def is_overdue(self) -> bool:
        return not self.is_returned and datetime.now() > self.due_date


class LibraryCatalogIterator:

    def __init__(self, books_list: list):
        self._books = books_list
        self._index = 0

    def __iter__(self):
        return self

    def __next__(self) -> Book:
        if self._index < len(self._books):
            book = self._books[self._index]
            self._index += 1
            return book
        raise StopIteration


class Library:

    def __init__(self, name: str):
        self.name = name
        self._books = []
        self._readers = []
        self._records = []
        self._record_counter = 1

    def add_book(self, book: Book):
        self._books.append(book)

    def register_reader(self, reader: Reader):
        self._readers.append(reader)

    def calculate_statistics(self) -> dict:
        total = len(self._books)
        available_count = sum(1 for b in self._books if b.is_available)
        return {
            "total_books": total,
            "available_books": available_count,
            "issued_books": total - available_count,
        }

    def issue_book(
        self, book_id: int, reader_id: int, days: int = 14
    ) -> (bool, str):
        book = next((b for b in self._books if b.book_id == book_id), None)
        if not book:
            return False, "Книгу з таким ID не знайдено."
        if not book.is_available:
            return False, "Книга вже видана іншому читачу."

        reader = next((r for r in self._readers if r.reader_id == reader_id), None)
        if not reader:
            return False, "Читача з таким ID не знайдено."

        # ПЕРЕВІРКА БЛОКУВАННЯ
        if reader.is_blocked:
            return (
                False,
                f"Читач {reader.name} є ЗАБЛОКОВАНИМ! Видача книг заборонена.",
            )

        record = BorrowRecord(
            self._record_counter, book, reader, days_allowed=days
        )
        self._records.append(record)
        self._record_counter += 1
        book.is_available = False
        return True, f"Книгу '{book.title}' успішно видано читачу {reader.name}!"

    def return_book(self, book_id: int) -> (bool, str):
        for record in self._records:
            if record.book.book_id == book_id and not record.is_returned:
                record.is_returned = True
                record.book.is_available = True
                return True, f"Книгу '{record.book.title}' успішно повернуто."
        return False, "Не знайдено активного запису видачі для цієї книги."

    def return_book_and_block_reader(self, book_id: int) -> (bool, str):
        """Повертає книгу та заблоковує читача, який її брав"""
        for record in self._records:
            if record.book.book_id == book_id and not record.is_returned:
                record.is_returned = True
                record.book.is_available = True
                record.reader.is_blocked = True
                return (
                    True,
                    f"Книгу '{record.book.title}' повернуто, а читача {record.reader.name} ЗАБЛОКОВАНО!",
                )
        return False, "Не знайдено активного запису видачі для цієї книги."

    def toggle_reader_block(self, reader_id: int) -> (bool, str):
        """Змінює статус блокування читача на протилежний"""
        reader = next((r for r in self._readers if r.reader_id == reader_id), None)
        if not reader:
            return False, "Читача не знайдено."

        reader.is_blocked = not reader.is_blocked
        status_str = (
            "заблоковано ❌" if reader.is_blocked else "розблоковано ✅"
        )
        return True, f"Читача {reader.name} успішно {status_str}."

    def get_active_borrows(self) -> list:
        return [r for r in self._records if not r.is_returned]

    def get_borrower_of_book(self, book_id: int) -> str:
        for record in self._records:
            if record.book.book_id == book_id and not record.is_returned:
                return record.reader.name
        return "-"

    def get_debtors(self) -> list:
        debtors = []
        for record in self._records:
            if record.is_overdue():
                debtors.append(
                    {
                        "reader": record.reader,
                        "book": record.book,
                        "due_date": record.due_date,
                    }
                )
        return debtors

    def __iter__(self):
        return LibraryCatalogIterator(self._books)





