    def refresh_catalog(self):
        for item in self.tree_catalog.get_children():
            self.tree_catalog.delete(item)

        for book in self.lib:
            status = "Доступна" if book.is_available else "Видана"
            borrower = self.lib.get_borrower_of_book(book.book_id)
            self.tree_catalog.insert(
                "",
                "end",
                values=(
                    book.book_id,
                    book.title,
                    book.author,
                    book.year,
                    status,
                    borrower,
                ),
            )

        stats = self.lib.calculate_statistics()
        self.lbl_stats.config(
            text=f"Усього книг: {stats['total_books']}  |  В наявності: {stats['available_books']}  |  Видано: {stats['issued_books']}"
